<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<title>Overlay</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
html,body{background:transparent !important;width:100%;height:100%;overflow:hidden;}
body{display:flex;align-items:center;justify-content:center;position:relative;}
.outer{display:inline-flex;flex-direction:column;align-items:center;gap:10px;position:relative;z-index:1;}
.wrap{display:inline-flex;align-items:baseline;position:relative;}

/* ── TIMER ── */
#timer-wrap{
  display:none;
  align-items:center;justify-content:center;gap:8px;
}
#timer-wrap.visible{display:flex;}
#timer-display{
  font-variant-numeric:tabular-nums;
  transition:color 0.2s,text-shadow 0.2s;
  line-height:1;
}
@keyframes timerBlink{0%,100%{opacity:1}50%{opacity:0.15}}
@keyframes timerPulse{0%,100%{transform:scale(1)}45%{transform:scale(1.06)}}
#particle-canvas{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:10;}
@keyframes bou{0%{transform:scale(1)}30%{transform:scale(1.18)}60%{transform:scale(0.94)}80%{transform:scale(1.06)}100%{transform:scale(1)}}
@keyframes flashWin{0%{opacity:1}25%{opacity:0.2}50%{opacity:1}75%{opacity:0.5}100%{opacity:1}}
@keyframes flashLoss{0%{filter:brightness(1)}30%{filter:brightness(2.5)}60%{filter:brightness(1)}100%{filter:brightness(1)}}
@keyframes shake{0%{transform:translateX(0)}15%{transform:translateX(-6px)}30%{transform:translateX(6px)}45%{transform:translateX(-4px)}60%{transform:translateX(4px)}75%{transform:translateX(-2px)}90%{transform:translateX(2px)}100%{transform:translateX(0)}}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}
.bou{animation:bou 0.38s ease;}
.flash-win{animation:flashWin 0.5s ease;}
.flash-loss{animation:flashLoss 0.4s ease;}
.shake-loss{animation:shake 0.45s ease;}
.pulse-glow{animation:pulse 1.5s ease-in-out infinite;}
</style>
</head>
<body>
<canvas id="particle-canvas"></canvas>
<div class="outer">
  <div class="wrap" id="wrap">
    <span id="win-el" style="font-size:72px;font-weight:700;line-height:1;color:#ffffff;font-variant-numeric:tabular-nums;transition:color 0.2s;font-family:'Segoe UI',sans-serif;">0</span>
    <span id="sep-el" style="font-size:56px;font-weight:300;color:rgba(255,255,255,0.35);margin:0 8px;line-height:1;font-family:'Segoe UI',sans-serif;">/</span>
    <span id="goal-el" style="font-size:72px;font-weight:700;color:rgba(255,255,255,0.4);line-height:1;font-variant-numeric:tabular-nums;font-family:'Segoe UI',sans-serif;">5</span>
  </div>
  <div id="timer-wrap">
    <span id="timer-display">00:00</span>
  </div>
</div>

<script type="module">
import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js';
import { getDatabase, ref, onValue } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js';

const FB_URL = 'https://my-overlay-d6bc7-default-rtdb.asia-southeast1.firebasedatabase.app';
const app = initializeApp({ databaseURL: FB_URL }, 'overlay');
const db  = getDatabase(app);
const dbRef = ref(db, 'overlay');

let cur = {win:0, goal:5};
let sty = {
  font:'Segoe UI',size:72,weight:700,ls:0,
  cpos:'#2ecc71',cneg:'#e74c3c',czero:'#ffffff',
  cgoal:'#ffffff',gopac:0.4,csep:'#ffffff',sopac:0.35,
  cbg:'#000000',bgopac:0,pad:0,rad:0,sep:'/',sepsize:56,
  strokeEnable:false,strokeWidth:2,strokeColor:'#000000',strokeOpac:1,
  glowEnable:false,glowColor:'#5b6ef5',glowSize:12,glowOpac:0.8,
  shadowEnable:false,shadowColor:'#000000',shadowX:2,shadowY:2,shadowBlur:4,shadowOpac:0.8,
  borderEnable:false,borderColor:'#ffffff',borderWidth:2,borderOpac:0.5,
  winAnim:'bounce',lossAnim:'bounce',pulseEnable:false,
  rollEnable:true,rollSpeed:3,
  particleShape:'stars',particleCount:20,particleSpeed:5,particleSize:12
};
let tsty = {
  font:'Courier New',size:36,weight:700,ls:3,
  color:'#ffffff',opac:0.85,
  urgentColor:'#ff4757',urgsec:10,
  bg:'#000000',bgopac:0,pad:0,rad:0,
  borderEnable:false,borderColor:'#ffffff',borderWidth:2,borderOpac:0.8,
  strokeEnable:false,strokeColor:'#000000',strokeWidth:2,strokeOpac:1,
  glowEnable:false,glowColor:'#ffffff',glowSize:12,glowOpac:0.25
};

const OVERLAY_SYSTEM_FONTS = new Set(['Segoe UI','Arial','Verdana','Tahoma','Impact','Georgia','Courier New','Trebuchet MS']);
const overlayLoadedFonts = new Set();
function loadOverlayFont(family){
  if(OVERLAY_SYSTEM_FONTS.has(family)||overlayLoadedFonts.has(family))return;
  overlayLoadedFonts.add(family);
  const link=document.createElement('link');
  link.rel='stylesheet';
  const q=encodeURIComponent(family+':ital,wght@0,100;0,300;0,400;0,700;0,900');
  link.href=`https://fonts.googleapis.com/css2?family=${q}&display=swap`;
  document.head.appendChild(link);
}


const wEl=document.getElementById('win-el');
const gEl=document.getElementById('goal-el');
const sEl=document.getElementById('sep-el');
const wrap=document.getElementById('wrap');

// ══════════════════════════════
//  PARTICLE SYSTEM
// ══════════════════════════════
const canvas = document.getElementById('particle-canvas');
const ctx = canvas.getContext('2d');
let particles = [];

function resizeCanvas(){
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
resizeCanvas();
window.addEventListener('resize', resizeCanvas);

function hexToRgb(h){
  const r=parseInt(h.slice(1,3),16);
  const g=parseInt(h.slice(3,5),16);
  const b=parseInt(h.slice(5,7),16);
  return [r,g,b];
}

const WIN_COLORS  = ['#2ecc71','#27ae60','#00d2b4','#5b6ef5','#f9ca24'];
const LOSS_COLORS = ['#e74c3c','#c0392b','#fd79a8','#d63031','#ff6b81'];

function spawnParticles(type){
  const shape  = sty.particleShape || 'stars';
  const count  = sty.particleCount || 20;
  const speed  = (sty.particleSpeed || 5) * 0.9;
  const size   = sty.particleSize  || 12;
  const colors = type === 'win' ? WIN_COLORS : LOSS_COLORS;

  // spawn from center of viewport
  const cx = canvas.width  / 2;
  const cy = canvas.height / 2;

  for(let i = 0; i < count; i++){
    const angle = Math.random() * Math.PI * 2;
    const v     = (0.4 + Math.random()) * speed;
    const col   = colors[Math.floor(Math.random() * colors.length)];
    const [r,g,b] = hexToRgb(col);
    particles.push({
      x:  cx + (Math.random()-0.5)*30,
      y:  cy + (Math.random()-0.5)*20,
      vx: Math.cos(angle)*v,
      vy: Math.sin(angle)*v - speed*0.3,
      size: (0.6+Math.random()) * size,
      alpha: 1,
      rot:  Math.random()*Math.PI*2,
      rotV: (Math.random()-0.5)*0.22,
      r,g,b,
      shape
    });
  }
}

function drawStar(ctx,x,y,sz,rot){
  const n=5, outer=sz*0.5, inner=sz*0.2;
  ctx.beginPath();
  for(let i=0;i<n*2;i++){
    const r2=i%2===0?outer:inner;
    const a=rot+i*Math.PI/n;
    i===0?ctx.moveTo(x+Math.cos(a)*r2,y+Math.sin(a)*r2):ctx.lineTo(x+Math.cos(a)*r2,y+Math.sin(a)*r2);
  }
  ctx.closePath();
}

function drawSpark(ctx,x,y,sz,rot){
  ctx.save();ctx.translate(x,y);ctx.rotate(rot);
  ctx.lineWidth = Math.max(1.2, sz*0.12);
  ctx.beginPath();
  for(let i=0;i<4;i++){
    const a=i*Math.PI/2;
    ctx.moveTo(0,0);
    ctx.lineTo(Math.cos(a)*sz*0.55, Math.sin(a)*sz*0.55);
  }
  ctx.stroke();
  // small diagonal sparks
  for(let i=0;i<4;i++){
    const a=i*Math.PI/2+Math.PI/4;
    ctx.moveTo(0,0);
    ctx.lineTo(Math.cos(a)*sz*0.3, Math.sin(a)*sz*0.3);
  }
  ctx.stroke();
  ctx.restore();
}

let rafId = null;
function particleLoop(){
  rafId = requestAnimationFrame(particleLoop);
  ctx.clearRect(0,0,canvas.width,canvas.height);

  for(let i=particles.length-1;i>=0;i--){
    const p=particles[i];
    p.x  += p.vx;
    p.y  += p.vy;
    p.vy += 0.22;        // gravity
    p.vx *= 0.98;        // air drag
    p.rot+= p.rotV;
    p.alpha -= 0.022;
    if(p.alpha<=0){particles.splice(i,1);continue;}

    ctx.save();
    ctx.globalAlpha = Math.max(0, p.alpha);
    ctx.fillStyle   = `rgb(${p.r},${p.g},${p.b})`;
    ctx.strokeStyle = `rgb(${p.r},${p.g},${p.b})`;

    if(p.shape === 'stars'){
      drawStar(ctx, p.x, p.y, p.size, p.rot);
      ctx.fill();
    } else {
      drawSpark(ctx, p.x, p.y, p.size, p.rot);
    }
    ctx.restore();
  }
}
particleLoop();

// ══════════════════════════════
//  ROLL COUNTER
// ══════════════════════════════
let displayWin=0, targetWin=0, rollTimer=null, rollDir=0;
let flashTimer=null, settleTimer=null, tempColorDir=null;

function startRoll(from,to){
  if(rollTimer)clearInterval(rollTimer);
  if(settleTimer)clearTimeout(settleTimer);
  displayWin=from;targetWin=to;
  if(from===to)return;
  rollDir=to>from?1:-1;
  const spd=Math.max(1,Math.min(5,sty.rollSpeed||3));
  const intervalMs=Math.round(120/Math.pow(2,spd-1));
  tempColorDir=rollDir>0?'win':'loss';
  setWinColor(displayWin,tempColorDir);
  const rollStart=Date.now();
  const MIN_MS=350;
  rollTimer=setInterval(()=>{
    const diff=Math.abs(targetWin-displayWin);
    let step=diff>50?Math.ceil(diff*0.12):diff>20?Math.ceil(diff*0.2):diff>5?2:1;
    displayWin+=rollDir*step;
    if((rollDir>0&&displayWin>=targetWin)||(rollDir<0&&displayWin<=targetWin)){
      displayWin=targetWin;
      wEl.textContent=displayWin;
      clearInterval(rollTimer);rollTimer=null;
      const rem=Math.max(0,MIN_MS-(Date.now()-rollStart));
      settleTimer=setTimeout(()=>{settleTimer=null;tempColorDir=null;setWinColor(displayWin);},rem);
      return;
    }
    wEl.textContent=displayWin;
    setWinColor(displayWin,tempColorDir);
  },intervalMs);
}

function hexRgb(h){const r=parseInt(h.slice(1,3),16),g=parseInt(h.slice(3,5),16),b=parseInt(h.slice(5,7),16);return`${r},${g},${b}`;}

function buildTextShadow(s){
  const parts=[];
  if(s.strokeEnable&&s.strokeWidth>0){
    const sc=`rgba(${hexRgb(s.strokeColor)},${s.strokeOpac})`;
    const w=s.strokeWidth;
    [-w,0,w].forEach(x=>[-w,0,w].forEach(y=>{if(x||y)parts.push(`${x}px ${y}px 0 ${sc}`);}));
  }
  if(s.glowEnable){
    const gc=`rgba(${hexRgb(s.glowColor)},${s.glowOpac})`;
    parts.push(`0 0 ${s.glowSize}px ${gc}`,`0 0 ${s.glowSize*2}px ${gc}`);
  }
  if(s.shadowEnable){
    const shc=`rgba(${hexRgb(s.shadowColor)},${s.shadowOpac})`;
    parts.push(`${s.shadowX}px ${s.shadowY}px ${s.shadowBlur}px ${shc}`);
  }
  return parts.length?parts.join(','):'none';
}

function applyStyle(s){
  loadOverlayFont(s.font||'Segoe UI');
  const ts=buildTextShadow(s);
  const base=`font-family:'${s.font}',sans-serif;font-size:${s.size}px;font-weight:${s.weight};letter-spacing:${s.ls}px;font-variant-numeric:tabular-nums;line-height:1;transition:color 0.2s;text-shadow:${ts};`;
  wEl.style.cssText=base;
  gEl.style.cssText=`${base}color:rgba(${hexRgb(s.cgoal)},${s.gopac});`;
  sEl.style.cssText=`font-family:'${s.font}',sans-serif;font-size:${s.sepsize}px;font-weight:300;color:rgba(${hexRgb(s.csep)},${s.sopac});margin:0 ${Math.round(s.size*0.1)}px;line-height:1;text-shadow:${ts};`;
  const bg=s.bgopac>0?`rgba(${hexRgb(s.cbg)},${s.bgopac})`:'transparent';
  const border=s.borderEnable?`${s.borderWidth}px solid rgba(${hexRgb(s.borderColor)},${s.borderOpac})`:'none';
  wrap.style.cssText=`display:inline-flex;align-items:baseline;padding:${s.pad}px;border-radius:${s.rad}px;background:${bg};border:${border};`;
  if(tempColorDir) setWinColor(rollTimer||settleTimer?displayWin:cur.win,tempColorDir);
  else setWinColor(cur.win);
  if(s.pulseEnable)wEl.classList.add('pulse-glow');else wEl.classList.remove('pulse-glow');
}

function realColor(val){return val>0?sty.cpos:val<0?sty.cneg:sty.czero;}
function setWinColor(val,dir){
  if(dir==='win')wEl.style.color=sty.cpos;
  else if(dir==='loss')wEl.style.color=sty.cneg;
  else wEl.style.color=realColor(val);
}

function doAnim(el,animClass){
  el.classList.remove('bou','flash-win','flash-loss','shake-loss');
  void el.offsetWidth;
  el.classList.add(animClass);
  el.addEventListener('animationend',()=>el.classList.remove(animClass),{once:true});
}
function animForWin(type){
  if(type==='win'){
    if(sty.winAnim==='flash')doAnim(wEl,'flash-win');
    else if(sty.winAnim!=='none')doAnim(wEl,'bou');
  } else {
    if(sty.lossAnim==='shake')doAnim(wEl,'shake-loss');
    else if(sty.lossAnim==='flash')doAnim(wEl,'flash-loss');
    else doAnim(wEl,'bou');
  }
}

// ══════════════════════════════
//  COUNTDOWN TIMER
// ══════════════════════════════
const timerWrap = document.getElementById('timer-wrap');
const timerDisplay = document.getElementById('timer-display');
let timerState = { enabled:false, running:false, remaining:0, endAt:null };
let timerRAF = null;

function fmtTime(s){
  s = Math.max(0, Math.round(s));
  const m = Math.floor(s/60), sec = s%60;
  return `${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
}

function timerTick(){
  if(!timerState.running || !timerState.endAt){ timerRAF=null; return; }
  const rem = Math.max(0, (timerState.endAt - Date.now()) / 1000);
  timerDisplay.textContent = fmtTime(rem);
  const urgSec = tsty.urgsec || 10;
  const isUrgent = rem > 0 && rem <= urgSec;
  if(isUrgent){
    const uc = tsty.urgentColor||'#ff4757';
    timerDisplay.style.color = uc;
    timerDisplay.style.textShadow = `0 0 16px ${uc}b0, 0 0 32px ${uc}60`;
  } else {
    timerDisplay.style.color = `rgba(${hexRgbOv(tsty.color||'#ffffff')},${tsty.opac??0.85})`;
    timerDisplay.style.textShadow = buildTimerTextShadow(tsty);
  }
  if(rem <= 0){
    const uc = tsty.urgentColor||'#ff4757';
    timerDisplay.style.color = uc;
    timerDisplay.style.textShadow = `0 0 20px ${uc}e0, 0 0 40px ${uc}80`;
    timerDisplay.style.animation = 'timerBlink 0.55s ease-in-out infinite';
    timerDisplay.textContent = '00:00';
    timerState.running = false;
    timerState.endAt = null;
    // burst particles on time's up!
    spawnParticles('win');
    setTimeout(()=>spawnParticles('win'), 200);
    timerRAF = null;
    return;
  }
  timerRAF = requestAnimationFrame(timerTick);
}

function hexRgbOv(h){const r=parseInt(h.slice(1,3),16),g=parseInt(h.slice(3,5),16),b=parseInt(h.slice(5,7),16);return`${r},${g},${b}`;}

function buildTimerTextShadow(s){
  const parts=[];
  if(s.strokeEnable&&s.strokeWidth>0){
    const sc=`rgba(${hexRgbOv(s.strokeColor)},${s.strokeOpac})`;
    const w=s.strokeWidth;
    [-w,0,w].forEach(x=>[-w,0,w].forEach(y=>{if(x||y)parts.push(`${x}px ${y}px 0 ${sc}`);}));
  }
  if(s.glowEnable){
    const gc=`rgba(${hexRgbOv(s.glowColor)},${s.glowOpac})`;
    parts.push(`0 0 ${s.glowSize}px ${gc}`,`0 0 ${s.glowSize*2}px ${gc}`);
  }
  return parts.length?parts.join(','):'none';
}

function applyTimerStyle(s){
  loadOverlayFont(s.font||'Courier New');
  const ts=buildTimerTextShadow(s);
  timerDisplay.style.cssText=`font-family:'${s.font||'Courier New'}',monospace,sans-serif;font-size:${s.size||36}px;font-weight:${s.weight||700};letter-spacing:${s.ls||3}px;font-variant-numeric:tabular-nums;line-height:1;transition:color 0.2s,text-shadow 0.2s;color:rgba(${hexRgbOv(s.color||'#ffffff')},${s.opac??0.85});text-shadow:${ts};`;
  const bg=s.bgopac>0?`rgba(${hexRgbOv(s.bg||'#000000')},${s.bgopac})`:'transparent';
  const border=s.borderEnable?`${s.borderWidth||2}px solid rgba(${hexRgbOv(s.borderColor||'#ffffff')},${s.borderOpac??0.8})`:'none';
  timerWrap.style.cssText=`display:${timerWrap.classList.contains('visible')?'flex':'none'};align-items:center;justify-content:center;gap:8px;padding:${s.pad||0}px;border-radius:${s.rad||0}px;background:${bg};border:${border};`;
  // store urgent settings for timerTick
  timerDisplay._tsty = s;
}

function applyTimerState(ts){
  if(!ts) return;
  timerState = {...timerState, ...ts};
  // show/hide
  if(timerState.enabled){ timerWrap.classList.add('visible'); timerWrap.style.display='flex'; }
  else { timerWrap.classList.remove('visible'); timerWrap.style.display='none'; timerState.running=false; timerState.endAt=null; }

  if(timerState.running && timerState.endAt){
    timerDisplay.style.animation='';
    timerDisplay.style.color=`rgba(${hexRgbOv(tsty.color||'#ffffff')},${tsty.opac??0.85})`;
    timerDisplay.style.textShadow=buildTimerTextShadow(tsty);
    if(!timerRAF) timerRAF = requestAnimationFrame(timerTick);
  } else if(!timerState.running){
    if(timerRAF){ cancelAnimationFrame(timerRAF); timerRAF=null; }
    if(!timerState.endAt){ // stopped/reset
      timerDisplay.style.animation='';
      timerDisplay.style.color=`rgba(${hexRgbOv(tsty.color||'#ffffff')},${tsty.opac??0.85})`;
      timerDisplay.style.textShadow=buildTimerTextShadow(tsty);
      timerDisplay.textContent = fmtTime(timerState.remaining||0);
    }
  }
}

onValue(dbRef, snap => {
  const d=snap.val();if(!d)return;
  let cW=false,cG=false,wDir=null;
  if(d.sty){sty={...sty,...d.sty};applyStyle(sty);}
  if(d.tsty){tsty={...tsty,...d.tsty};applyTimerStyle(tsty);}
  if(d.timer) applyTimerState(d.timer);
  if(d.state){
    if(d.state.win!==undefined&&d.state.win!==cur.win){
      wDir=d.state.win>cur.win?'win':'loss';
      cur.win=d.state.win;cW=true;
      // fire particles!
      spawnParticles(wDir);
      if(sty.rollEnable){
        startRoll(displayWin,cur.win);
      } else {
        displayWin=cur.win;
        wEl.textContent=cur.win;
        tempColorDir=wDir;
        setWinColor(cur.win,wDir);
        clearTimeout(flashTimer);
        flashTimer=setTimeout(()=>{flashTimer=null;tempColorDir=null;setWinColor(displayWin);},450);
      }
    }
    if(d.state.goal!==undefined&&d.state.goal!==cur.goal){cur.goal=d.state.goal;cG=true;}
  }
  if(!cW){wEl.textContent=displayWin;setWinColor(displayWin);}
  gEl.textContent=cur.goal;
  sEl.textContent=sty.sep;
  if(cW&&!sty.rollEnable)animForWin(wDir);
  if(cW&&sty.rollEnable){
    const origTarget=cur.win;
    const chk=setInterval(()=>{if(displayWin===origTarget){clearInterval(chk);animForWin(wDir);}},50);
    setTimeout(()=>clearInterval(chk),5000);
  }
  if(cG)doAnim(gEl,'bou');
});
</script>
</body>
</html>
